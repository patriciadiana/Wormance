  npcPortrait: {fileID: -7761770620401085828, guid: 399b27eadcf4a5f4da7171113e3a29aa, type: 3}
  dialogueLines:
  - "\u201CWAIT. IS THAT HER? THAT'S THE WORM! THE LEGENDARY WORM! What do you want for her? \u201D "
  - '"I didn''t even mention money yet! But now that you bring it up... everything has a price, right?"  '
  - '"I KNEW YOU WERE A REASONABLE MAN! Finally, someone who understands the value of scientific progress. Let''s discuss numbers. "  '
  - '"Your cousin is a worm? Honestly, I have so many questions, but I''m choosing to respect your family''s privacy."  '
