  m_Name: Mom_First_Call
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  npcId: Mom
  npcName: Girlfriend's Mom
  npcPortrait: {fileID: 0}
  dialogueLines:
  - '"Hi, sweetheart! Is my daughter there? She hasn''t answered any of my messages today."'
  - '"Oh, good! She spends too much time on that thing anyway. Tell her I love her and that I''ll call tomorrow."'
  - '"Excuse me?! It''s her mother! Why are you acting like you don''t know me? Is something going on over there?"'
  - '"In the garden? That''s lovely, but it''s raining. Could you ask her to come inside and call me when she''s done?"'
